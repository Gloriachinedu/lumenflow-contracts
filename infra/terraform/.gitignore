# Local .terraform directories
**/.terraform/*

# Terraform state files – never commit these
*.tfstate
*.tfstate.*
*.tfstate.backup

# Sensitive variable files
*.tfvars
!*.tfvars.example

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Generated plan files
*.tfplan
