# ── Rust / Cargo ──────────────────────────────────────────────────────────────
/target/
**/*.rs.bk

# WASM build artifacts
*.wasm

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.orig

# ── OS artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Stellar CLI ───────────────────────────────────────────────────────────────
.soroban/
identity/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Node / JavaScript ────────────────────────────────────────────────────────
node_modules/

# Build dist output (SDK)
dist/
sdk/dist/

# ── Test artifacts ────────────────────────────────────────────────────────────

# Rust test snapshots (insta / similar snapshot testing libraries)
contracts/lumenflow/test_snapshots/
**/__snapshots__/
**/*.snap

# Playwright screenshots and test results
tests/playwright/screenshots/
tests/playwright/test-results/
tests/playwright/playwright-report/
**/test-results/
**/playwright-report/

# Vitest / Jest snapshots
**/__snapshots__/

# ── Coverage ──────────────────────────────────────────────────────────────────
coverage/
lcov.info
*.lcov
.nyc_output/

# ── Build / CI artifacts ──────────────────────────────────────────────────────
# Local backup bundles (produced by scripts/backup-manager.mjs)
backup-bundle/

# Generated benchmark regression report (produced by scripts/check-benchmark-regression.sh)
benchmark-results.md

# Smoke test ephemeral npm cache
scripts/.smoke_node_modules/

# Terraform state files and sensitive plans
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/*.tfplan
infra/terraform/*.tfvars
!infra/terraform/terraform.tfvars.example

# Temporary / scratch files
*.tmp
*.bak
*.cache

# ── Snapshot update temporaries ───────────────────────────────────────────────
**/*.snap.new

# ── Turborepo ─────────────────────────────────────────────────────────────────
.turbo/

# ── TypeScript build info ─────────────────────────────────────────────────────
*.tsbuildinfo

# ── Package manager lock files (keep these, exclude only redundant artifacts) ─
# (Cargo.lock and package-lock.json are intentionally committed)

# ── Fuzz testing artifacts (Issue #1354) ─────────────────────────────────────
# cargo-fuzz output: crash artifacts, corpus, and coverage data
contracts/**/fuzz/artifacts/
contracts/**/fuzz/corpus/
contracts/**/fuzz/coverage/
# libfuzzer crash/timeout/oom input files
crash-*
timeout-*
oom-*
slow-*

# ── Cosign / Sigstore signing bundles (Issue #1352) ──────────────────────────
# Locally generated release signing bundles — these are published to GitHub
# Releases and should not be committed to the repository.
*.wasm.sig
*.wasm.cert

