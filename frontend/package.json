{
  "name": "lumenflow-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "LumenFlow static frontend preview",
  "scripts": {
    "dev": "browser-sync start --server . --files '**/*.html,**/*.css,**/*.js' --no-notify --port 3000",
    "serve": "npx serve . --listen 3000",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:a11y": "playwright test tests/a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.49.1",
    "browser-sync": "^3.0.4"
  }
}