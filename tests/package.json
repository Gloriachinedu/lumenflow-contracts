{
  "name": "@lumenflow/e2e-tests",
  "version": "1.0.0",
  "description": "LumenFlow end-to-end and visual regression tests",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test playwright/refund-lifecycle.spec.ts",
    "test:visual": "playwright test playwright/visual-regression.spec.ts",
    "test:update-snapshots": "playwright test --update-snapshots",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.44.1",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "serve": "14.2.3"
  }
}
