{
  "name": "@lumenflow/webhook-server",
  "version": "1.0.0",
  "description": "Idempotent webhook delivery server for LumenFlow Soroban contract events",
  "main": "webhook-server.js",
  "scripts": {
    "start": "node webhook-server.js",
    "pretest": "npm --prefix ../sdk run build --if-present",
    "test": "jest --testPathPattern='webhook/.*\\.test\\.js$' --no-coverage"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "dependencies": {
    "eventsource": "5.1.3",
    "node-fetch": "3.3.2"
  },
  "devDependencies": {
    "jest": "30.5.2"
  },
  "peerDependencies": {
    "ioredis": ">=5"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "license": "MIT"
}