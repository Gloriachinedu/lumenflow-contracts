# scripts/env/mainnet.env — Non-secret mainnet network configuration.
# This file is tracked in git. DO NOT add secret keys here.
# Mainnet secret keys are stored exclusively in GitHub Actions secrets as MAINNET_* variables.
# See docs/credential-separation.md for the full policy.
NETWORK=mainnet
RPC_URL=https://mainnet.stellar.validationcloud.io/v1/<YOUR_API_KEY>
NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
