# scripts/env/local.env — Non-secret local network configuration.
# This file is tracked in git. DO NOT add secret keys here.
# Local secret keys are passed via environment variable at runtime.
# See docs/credential-separation.md for the full policy.
NETWORK=local
RPC_URL=http://localhost:8000/soroban/rpc
NETWORK_PASSPHRASE="Standalone Network ; February 2017"
