# scripts/env/testnet.env — Non-secret testnet network configuration.
# This file is tracked in git. DO NOT add secret keys here.
# Testnet secret keys are stored exclusively in GitHub Actions secrets as TESTNET_* variables.
# See docs/credential-separation.md for the full policy.
NETWORK=testnet
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# USDC (Stellar) — issue #1576
# USDC SAC address on testnet, used by deploy.sh to call add_allowed_token(USDC_ADDRESS).
USDC_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Circle testnet USDC issuer account (GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5).
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5