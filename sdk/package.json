{
  "name": "@lumenflow/sdk",
  "version": "0.2.0",
  "description": "LumenFlow TypeScript SDK — Node.js wrapper for the LumenFlow Soroban contract",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "build:cjs": "tsup --format cjs",
    "build:esm": "tsup --format esm",
    "test": "jest",
    "test:cjs": "CJS_BUILD=1 jest",
    "smoke:esm": "node scripts/smoke-test-esm.mjs",
    "smoke:cjs": "node scripts/smoke-test-cjs.cjs",
    "verify:exports": "node scripts/verify-exports-map.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["stellar", "soroban", "lumenflow", "payments", "sdk"],
  "author": "LumenFlow Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gloriachinedu/lumenflow-contracts.git",
    "directory": "sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "7.0.2"
  }
}