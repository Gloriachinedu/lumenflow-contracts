{
  "name": "lumenflow-contracts-ui-tests",
  "private": true,
  "scripts": {
    "test:receipt": "playwright test tests/receipt.spec.js",
    "test:playwright": "playwright test tests/playwright/",
    "test:e2e": "playwright test",
