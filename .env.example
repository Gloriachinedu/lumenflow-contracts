# LumenFlow environment configuration
# Copy this file to .env.local, .env.testnet, or .env.mainnet and fill in the values.
# Never commit files other than .env.example to version control.

# Network name passed to the Stellar CLI (local | testnet | mainnet)
NETWORK=testnet

# RPC endpoint for the target network
# local:   http://localhost:8000/soroban/rpc
# testnet: https://soroban-testnet.stellar.org
# mainnet: https://soroban.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase
# local:   "Standalone Network ; February 2017"
# testnet: "Test SDF Network ; September 2015"
# mainnet: "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Stellar secret key used to pay deployment fees
SOURCE_ACCOUNT=

# Deployed contract ID (populated after first deploy)
CONTRACT_ID=

# Admin address (Stellar public key)
ADMIN_ADDRESS=

# ---------------------------------------------------------------------------
# OpenTelemetry distributed tracing
# ---------------------------------------------------------------------------
# Traces are exported to Jaeger locally and to an OTLP collector in production.
# See docs/observability.md for full tracing setup instructions.

# OTLP endpoint for production trace export (e.g. an OpenTelemetry Collector).
# Leave empty for local development to use the Jaeger endpoint below instead.
# production: http://otel-collector:4318  (or your managed OTLP endpoint)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Local Jaeger collector endpoint used when OTEL_EXPORTER_OTLP_ENDPOINT is empty.
# local: http://localhost:14268/api/traces
OTEL_JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Service name reported on spans. Override per service if needed
# (e.g. lumenflow-event-poller for the event poller).
OTEL_SERVICE_NAME=lumenflow-webhook

# Trace sampling strategy (parentbased_traceidratio | always_on | always_off).
# Use parentbased_traceidratio in production to control trace volume.
OTEL_TRACES_SAMPLER=parentbased_traceidratio

# Sampling ratio for the traceidratio sampler (0.0 - 1.0).
# local: 1.0 (sample everything)   production: 0.1 (sample 10%)
OTEL_TRACES_SAMPLER_ARG=1.0