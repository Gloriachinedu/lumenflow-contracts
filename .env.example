# LumenFlow environment configuration
# Copy this file to .env (or .env.local, .env.testnet, .env.mainnet) and fill in the values.
# Never commit files other than .env.example to version control.
#
# All environment-specific values are injected at container startup via these
# environment variables. The same container image can be deployed to any
# environment by supplying a different .env file. Run scripts/validate-secrets.sh
# before startup to verify every required variable is set.

# ---------------------------------------------------------------------------
# Network configuration
# ---------------------------------------------------------------------------

# Network name passed to the Stellar CLI (local | testnet | mainnet)
# Example: testnet
NETWORK=testnet

# RPC endpoint for the target network
# local:   http://localhost:8000/soroban/rpc
# testnet: https://soroban-testnet.stellar.org
# mainnet: https://soroban.stellar.org
# Example: https://soroban-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase
# local:   "Standalone Network ; February 2017"
# testnet: "Test SDF Network ; September 2015"
# mainnet: "Public Global Stellar Network ; September 2015"
# Example: "Test SDF Network ; September 2015"
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ---------------------------------------------------------------------------
# Deployment / contract configuration
# ---------------------------------------------------------------------------

# Stellar secret key used to pay deployment fees (starts with "S")
# Example: SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SOURCE_ACCOUNT=

# Deployed contract ID (populated after first deploy, starts with "C")
# Example: CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CONTRACT_ID=

# Admin address (Stellar public key, starts with "G")
# Example: GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ADMIN_ADDRESS=

# Admin API IP allowlist
# Comma-separated list of CIDR ranges permitted to access admin API endpoints
# (contract pause, emergency withdrawal, merchant suspension).
# Requests from IPs outside these ranges receive 403 Forbidden (not 401) to
# avoid leaking information about admin endpoint existence.
# Example: ADMIN_IP_ALLOWLIST=10.0.0.0/8,192.168.1.0/24,203.0.113.42/32
ADMIN_IP_ALLOWLIST=
